; Engine configuration file.
; CURSOR: Fragments of the Forgotten — v0.1 vertical slice.

config_version=5

[application]

config/name="CURSOR: Fragments of the Forgotten"
config/description="Top-down cyberpunk dungeon crawler — vertical slice."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Mobile")

[autoload]

InputBus="*res://scripts/autoload/input_bus.gd"
SpriteFactory="*res://scripts/autoload/sprite_factory.gd"
GameEvents="*res://scripts/autoload/game_events.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[layer_names]

2d_physics/layer_1="Player"
2d_physics/layer_2="Enemies"
2d_physics/layer_3="Walls"
2d_physics/layer_4="Pickups"

[physics]

2d/default_gravity=0.0

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true

[debug]

gdscript/warnings/enable=true
gdscript/warnings/unused_variable=true
gdscript/warnings/unused_parameter=true

